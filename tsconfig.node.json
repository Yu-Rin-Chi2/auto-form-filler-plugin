{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "poc/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vite.content.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
