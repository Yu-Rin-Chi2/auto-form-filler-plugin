{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auto-form-filler-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "routes": [
    {
      "pattern": "formfill.yrctool.stream",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      // period は 10 または 60 しか指定できない（Cloudflare の仕様）
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
